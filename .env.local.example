# Salin file ini menjadi .env.local lalu isi dengan kredensial project Supabase-mu.
# Ambil dari Supabase Dashboard -> Settings -> API.
# JANGAN pernah isi service_role key di sini (harus tetap rahasia, hanya untuk server).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
